<resources>
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">#147FB3</item>
        <item name="android:statusBarColor">#EAF5FB</item>
        <item name="android:navigationBarColor">#F4F8FA</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowBackground">@color/app_background</item>
    </style>
    <style name="WidgetForecastCell">
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#6C808B</item>
        <item name="android:textSize">9sp</item>
    </style>
</resources>
