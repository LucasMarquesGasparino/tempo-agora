        <TextView android:id="@+id/widget_day_1_probability" style="@style/WidgetForecastCell" android:layout_height="wrap_content" android:layout_width="0dp" android:layout_weight="0.9" android:gravity="end" android:textColor="#183544" />
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:background="#E8EFF2" android:includeFontPadding="false" android:text="" />
