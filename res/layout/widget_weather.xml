<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="11dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_place"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Atemporal"
                android:textColor="#183544"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_subtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sua cidade"
                android:textColor="#6C808B"
                android:textSize="10sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="52dp"
            android:layout_height="wrap_content"
            android:gravity="end|center_vertical"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:includeFontPadding="false"
                android:text="02/10"
                android:textColor="#6C808B"
                android:textSize="10sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_icon"
                android:layout_width="34dp"
                android:layout_height="22dp"
                android:gravity="center"
                android:text="☁"
                android:textColor="#177FAE"
                android:textSize="20sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="2dp">

        <TextView
            android:id="@+id/widget_temperature"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:includeFontPadding="false"
            android:text="—°"
            android:textColor="#183544"
            android:textSize="36sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_condition"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Carregando clima"
                android:textColor="#183544"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_feels"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Sensação —"
                android:textColor="#6C808B"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="4dp">

        <TextView
            android:id="@+id/widget_rain"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Chuva —"
            android:textColor="#339DC5"
            android:textSize="10sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_humidity"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Umidade —"
            android:textColor="#6C808B"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_today_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:background="@drawable/widget_today_heading"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:text="HOJE · A CADA 3H"
        android:textColor="#183544"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/widget_today_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_today_table"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/widget_today_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="HORA" android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.65" android:gravity="center" android:text="TEMP." android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="mm" android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="end" android:text="CHANCE" android:textColor="#6C808B" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_today_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_forecast_section_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp"
        android:background="#CAD9DF"
        android:visibility="gone" />

    <TextView
        android:id="@+id/widget_days_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:background="@drawable/widget_days_heading"
        android:paddingStart="7dp"
        android:paddingTop="3dp"
        android:paddingEnd="7dp"
        android:paddingBottom="3dp"
        android:text="DIÁRIO · PRÓXIMOS 7 DIAS"
        android:textColor="#183544"
        android:textSize="9sp"
        android:textStyle="bold"
        android:visibility="gone" />



    <LinearLayout
        android:id="@+id/widget_days_table"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/widget_days_table"
        android:layoutDirection="ltr"
        android:orientation="vertical"
        android:paddingStart="6dp"
        android:paddingEnd="6dp"
        android:visibility="gone">
        <LinearLayout
            android:id="@+id/widget_days_columns"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal"
            android:paddingTop="2dp"
            android:paddingBottom="1dp">
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.15" android:text="DIA" android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.65" android:gravity="center" android:text="MÁX / MÍN" android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="end" android:text="mm" android:textColor="#6C808B" android:textSize="8sp" />
            <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="0.9" android:gravity="end" android:text="CHANCE" android:textColor="#6C808B" android:textSize="8sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/widget_days_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="3dp">

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Sem dados recentes"
            android:textColor="#6C808B"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/widget_refresh_button"
            android:contentDescription="Atualizar previsão do tempo"
            android:gravity="center"
            android:minWidth="76dp"
            android:paddingStart="9dp"
            android:paddingEnd="9dp"
            android:text="↻ Atualizar"
            android:textColor="#177FAE"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
